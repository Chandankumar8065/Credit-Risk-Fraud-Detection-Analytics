// Credit Risk & Fraud Detection Analytics
// DAX measures for the lightweight, pre-aggregated Power BI model.
// Create each measure using Modeling > New measure.

// Customer profile
Total Customers =
SUM('01_customer_profile_summary'[customers])

// These are weighted averages: each segment's average is weighted by its
// customer count rather than treating every segment as the same size.
Average Customer Age =
DIVIDE(
    SUMX(
        '01_customer_profile_summary',
        '01_customer_profile_summary'[avg_age]
            * '01_customer_profile_summary'[customers]
    ),
    [Total Customers]
)

Average Annual Income =
DIVIDE(
    SUMX(
        '01_customer_profile_summary',
        '01_customer_profile_summary'[avg_annual_income_inr]
            * '01_customer_profile_summary'[customers]
    ),
    [Total Customers]
)

// Applications
Total Applications =
SUM('06_application_summary'[applications])

Average Requested Amount =
DIVIDE(
    SUMX(
        '06_application_summary',
        '06_application_summary'[avg_requested_amount_inr]
            * '06_application_summary'[applications]
    ),
    [Total Applications]
)

// Loans
Total Loans =
SUM('02_loan_type_summary'[total_loans])

Total Defaults =
SUM('02_loan_type_summary'[defaults])

Total Principal =
SUM('02_loan_type_summary'[total_principal_inr])

Default Rate =
DIVIDE([Total Defaults], [Total Loans], 0)

Average Interest Rate =
DIVIDE(
    SUMX(
        '02_loan_type_summary',
        '02_loan_type_summary'[avg_interest_rate_pct]
            * '02_loan_type_summary'[total_loans]
    ),
    [Total Loans]
)

// Fraud
Total Transactions =
SUM('07_fraud_channel_type_merchant'[transactions])

Fraud Transactions =
SUM('07_fraud_channel_type_merchant'[fraud_transactions])

Fraud Rate =
DIVIDE([Fraud Transactions], [Total Transactions], 0)

Transaction Value =
SUM('07_fraud_channel_type_merchant'[transaction_value_inr])

Average Transaction Value =
DIVIDE([Transaction Value], [Total Transactions], 0)

// Repayments
Total Installments =
SUM('11_repayment_status_summary'[installments])

Scheduled Amount =
SUM('11_repayment_status_summary'[scheduled_amount_inr])

Paid Amount =
SUM('11_repayment_status_summary'[paid_amount_inr])

Payment Shortfall =
[Scheduled Amount] - [Paid Amount]

Collection Rate =
DIVIDE([Paid Amount], [Scheduled Amount], 0)
